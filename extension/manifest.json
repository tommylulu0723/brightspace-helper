{
  "manifest_version": 3,
  "name": "课程助手 · Brightspace 截止时间 + 课件库",
  "short_name": "课程助手",
  "version": "1.1.0",
  "description": "汇总 NYU Brightspace 所有课程的截止时间、今日计划、公告、成绩，课件更新和截止时间改动会提醒你；课件按章节整理，一键下载。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "课程助手",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/dashboard/dashboard.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://brightspace.nyu.edu/*"
  ]
}
